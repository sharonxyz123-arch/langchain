import pdfplumber

def extract_stones(pdf_file):
    stones = []
    with pdfplumber.open(pdf_file) as pdf:
        for page in pdf.pages:
            table = page.extract_table()
            if table:
                headers = table[0]
                for row in table[1:]:
                    if row and len(row) >= 8:
                        stone = {
                            "id": row[0],
                            "name": row[2],
                            "weight": row[3],
                            "dimensions": row[4],
                            "origin": row[5],
                            "shape": row[6],
                            "treatment": row[7],
                            "color": row[8] if len(row) > 8 else ""
                        }
                        stones.append(stone)
    return stones

# Example usage
stones = extract_stones("stones.pdf")
print(stones[:3])  # preview first 3 entries
